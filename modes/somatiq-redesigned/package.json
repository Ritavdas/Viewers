{
  "name": "@ohif/mode-somatiq-redesigned",
  "version": "3.12.0-beta.7",
  "description": "OHIF mode for Somatiq redesigned viewer with glass morphism UI",
  "author": "Somatiq Team",
  "license": "MIT",
  "repository": "OHIF/Viewers",
  "main": "dist/ohif-mode-somatiq-redesigned.umd.js",
  "module": "src/index.ts",
  "engines": {
    "node": ">=14",
    "npm": ">=6",
    "yarn": ">=1.18.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ohif-mode",
    "somatiq",
    "redesign",
    "glass-morphism",
    "medical-imaging"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "clean:deep": "yarn run clean && shx rm -rf node_modules",
    "dev": "cross-env NODE_ENV=development webpack --config .webpack/webpack.dev.js --watch --output-pathinfo",
    "build": "cross-env NODE_ENV=production webpack --config .webpack/webpack.prod.js",
    "build:package": "yarn run build",
    "start": "yarn run dev",
    "test:unit": "jest --watchAll",
    "test:unit:ci": "jest --ci --runInBand --collectCoverage --passWithNoTests"
  },
  "peerDependencies": {
    "@ohif/core": "3.12.0-beta.7",
    "@ohif/extension-default": "3.12.0-beta.7",
    "@ohif/extension-cornerstone": "3.12.0-beta.7",
    "@ohif/extension-measurement-tracking": "3.12.0-beta.7",
    "@ohif/extension-cornerstone-dicom-sr": "3.12.0-beta.7",
    "@ohif/extension-cornerstone-dicom-seg": "3.12.0-beta.7",
    "@ohif/extension-cornerstone-dicom-rt": "3.12.0-beta.7",
    "@ohif/extension-dicom-pdf": "3.12.0-beta.7",
    "@ohif/extension-dicom-video": "3.12.0-beta.7",
    "@ohif/extension-somatiq-redesigned": "3.12.0-beta.7"
  },
  "dependencies": {
    "@babel/runtime": "^7.20.13",
    "i18next": "^17.0.3"
  }
}